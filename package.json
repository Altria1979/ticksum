{
  "name": "ticksum",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first browser activity analytics and reports.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/verify-manifest.mjs",
    "zip": "wxt zip && node scripts/verify-manifest.mjs",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite --config vite.preview.config.ts --host 127.0.0.1",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "dexie": "4.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "@types/chrome": "^0.1.32",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
